diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index e418820..3f8c52b 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -238,2 +238,8 @@ public final class ChunkHolderManager {
 
+    // Quantum - inspect native autosave scheduling without scanning holders or changing save order.
+    public int quantumAutosaveScheduledChunks() { return this.autoSaveQueue.size(); }
+    public long quantumOldestAutosaveAgeTicks() {
+        return this.autoSaveQueue.isEmpty() ? 0L : Math.max(0L, this.currentTick - this.autoSaveQueue.first().lastAutoSave);
+    }
+
     public void autoSave() {
