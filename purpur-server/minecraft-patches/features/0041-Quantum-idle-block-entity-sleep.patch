@@ -40,4 +40,35 @@ import org.slf4j.Logger;
 
 public abstract class BlockEntity implements DebugValueSource, TypedInstance<BlockEntityType<?>> {
+    private net.minecraft.world.level.chunk.LevelChunk.@Nullable RebindableTickingBlockEntityWrapper quantumTickWrapper;
+    private dev.quantumspigot.server.inventory.@Nullable TrackedItemList quantumSleepInventory;
+
+    public void quantumSetTickWrapper(net.minecraft.world.level.chunk.LevelChunk.@Nullable RebindableTickingBlockEntityWrapper wrapper) {
+        this.quantumTickWrapper = wrapper;
+    }
+
+    public void quantumWake() {
+        if (this.quantumTickWrapper != null) this.quantumTickWrapper.quantumSetSleeping(this, false);
+    }
+
+    protected void quantumSleep() {
+        if (this.quantumTickWrapper != null && !this.isRemoved()
+            && dev.quantumspigot.server.QuantumRuntime.mechanics().sleepingBlockEntities()) {
+            this.quantumTickWrapper.quantumSetSleeping(this, true);
+        }
+    }
+
+    protected net.minecraft.core.NonNullList<ItemStack> quantumTrackInventory(net.minecraft.core.NonNullList<ItemStack> contents) {
+        this.quantumWake();
+        if (this.quantumSleepInventory != null) this.quantumSleepInventory.detach();
+        this.quantumSleepInventory = null;
+        Class<?> type = this.getClass();
+        if (dev.quantumspigot.server.QuantumRuntime.mechanics().sleepingBlockEntities()
+            && (type == FurnaceBlockEntity.class || type == BlastFurnaceBlockEntity.class || type == SmokerBlockEntity.class
+                || type == BrewingStandBlockEntity.class || type == CampfireBlockEntity.class)) {
+            this.quantumSleepInventory = new dev.quantumspigot.server.inventory.TrackedItemList(contents, this::quantumWake);
+            return this.quantumSleepInventory;
+        }
+        return contents;
+    }
     static boolean ignoreBlockEntityUpdates; // Paper - Perf: Optimize Hoppers
     // CraftBukkit start - data containers
@@ -102,4 +133,5 @@ public abstract class BlockEntity implements DebugValueSource, TypedInstance<Blo
 
