Original Quantum additions: MIT (LICENSE-QUANTUM).
Base: PurpurMC/Purpur 3f5d9c0e80b56812c1694e014d44fabf540a4cad
Paper: e5fe71723e2ffde7cc9fafc085ac3bb73e63175e
Main-thread observation of existing tick/entity/player-chunk work only.
Disable inherited server telemetry to avoid identifying Quantum as Purpur.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 45c9274..c4d08f4 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -314,6 +314,12 @@ public final class RegionizedPlayerChunkLoader {
             }
             loader.update(); // can't invoke plugin logic
             loader.updateQueues(currTime);
+            // Quantum - observe existing per-player queues on their owning thread, after plugin callbacks.
+            if (!loader.removed && loader.world == this.world) {
+                dev.quantumspigot.server.QuantumRuntime.recordPlayerChunkQueues(
+                    loader.loadQueue.size(), loader.loadingQueue.size(), loader.genQueue.size(),
+                    loader.generatingQueue.size(), loader.sendQueue.size(), loader.tickingQueue.size());
+            }
         }
     }
 
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index d9402a7..230406a 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1108,6 +1108,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         // Paper end - rewrite chunk system
         // Paper start - Improved watchdog support - move final shutdown items here
         Util.shutdownExecutors();
+        dev.quantumspigot.server.QuantumRuntime.shutdown(); // Quantum - bounded report drain after world saves
         this.onServerExit();
         // Paper end - Improved watchdog support - move final shutdown items here
     }
@@ -1181,6 +1182,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.taskExecutionTime = 0L;
 
         this.addTickTime(time);
+        // Quantum - same work-duration boundary as upstream TickData; excludes idle wait.
+        dev.quantumspigot.server.QuantumRuntime.recordTick(time.tickLength() + time.intermediateTaskExecutionTime());
     }
 
     private void runAllTasksAtTickStart() {
