Earlier project attribution and license retained; outside LICENSE-QUANTUM.

diff --git a/net/minecraft/world/level/biome/TheEndBiomeSource.java b/net/minecraft/world/level/biome/TheEndBiomeSource.java
index c0c541e..fd1fbb6 100644
--- a/net/minecraft/world/level/biome/TheEndBiomeSource.java
+++ b/net/minecraft/world/level/biome/TheEndBiomeSource.java
@@ -26,6 +26,13 @@ public class TheEndBiomeSource extends BiomeSource {
     private final Holder<Biome> midlands;
     private final Holder<Biome> islands;
     private final Holder<Biome> barrens;
+    // Quantum - bounded C2ME cache adaptation. Each worker owns its map; sampler changes invalidate it.
+    private final ThreadLocal<QuantumBiomeCache> quantumBiomeCache = ThreadLocal.withInitial(QuantumBiomeCache::new);
+
+    private static final class QuantumBiomeCache {
+        Climate.Sampler sampler;
+        final it.unimi.dsi.fastutil.longs.Long2ObjectLinkedOpenHashMap<Holder<Biome>> biomes = new it.unimi.dsi.fastutil.longs.Long2ObjectLinkedOpenHashMap<>();
+    }
 
     public static TheEndBiomeSource create(final HolderGetter<Biome> biomes) {
         return new TheEndBiomeSource(
@@ -59,6 +66,26 @@ public class TheEndBiomeSource extends BiomeSource {
 
     @Override
     public Holder<Biome> getNoiseBiome(final int quartX, final int quartY, final int quartZ, final Climate.Sampler sampler) {
+        int capacity = dev.quantumspigot.server.QuantumRuntime.worldgen().endBiomeCacheEntries();
+        // Only the native immutable End-island density is Y-independent. Custom density functions bypass caching.
+        if (capacity == 0 || !net.minecraft.world.level.levelgen.DensityFunctions.quantumIsNativeEndIsland(sampler.erosion())) {
+            return this.quantumUncachedBiome(quartX, quartY, quartZ, sampler);
+        }
+        QuantumBiomeCache cache = this.quantumBiomeCache.get();
+        if (cache.sampler != sampler) {
+            cache.biomes.clear();
+            cache.sampler = sampler;
+        }
+        long key = net.minecraft.world.level.ChunkPos.pack(quartX, quartZ);
+        Holder<Biome> biome = cache.biomes.get(key);
+        if (biome != null) return biome;
+        biome = this.quantumUncachedBiome(quartX, quartY, quartZ, sampler);
+        cache.biomes.put(key, biome);
+        while (cache.biomes.size() > capacity) cache.biomes.removeFirst();
+        return biome;
+    }
+
+    private Holder<Biome> quantumUncachedBiome(final int quartX, final int quartY, final int quartZ, final Climate.Sampler sampler) {
         int blockX = QuartPos.toBlock(quartX);
         int blockY = QuartPos.toBlock(quartY);
         int blockZ = QuartPos.toBlock(quartZ);
diff --git a/net/minecraft/world/level/levelgen/DensityFunctions.java b/net/minecraft/world/level/levelgen/DensityFunctions.java
index ba8d441..b0443c2 100644
--- a/net/minecraft/world/level/levelgen/DensityFunctions.java
+++ b/net/minecraft/world/level/levelgen/DensityFunctions.java
@@ -32,6 +32,10 @@ import net.minecraft.world.level.levelgen.synth.SimplexNoise;
 import org.slf4j.Logger;
 
 public final class DensityFunctions {
+    public static boolean quantumIsNativeEndIsland(DensityFunction function) {
+        return function instanceof EndIslandDensityFunction;
+    }
+
     private static final Codec<DensityFunction> CODEC = BuiltInRegistries.DENSITY_FUNCTION_TYPE
         .byNameCodec()
         .dispatch(function -> function.codec().codec(), Function.identity());
