@@ -57,7 +63,14 @@ public class ClientboundLevelChunkPacketData {
         if (chunkPacketInfo != null) {
             chunkPacketInfo.setBuffer(this.buffer);
         }
-        extractChunkData(new FriendlyByteBuf(this.getWriteBuffer()), levelChunk, chunkPacketInfo);
+        if (deferSerialization) {
+            if (chunkPacketInfo != null) throw new IllegalArgumentException("Anti-Xray requires native serialization");
+            LevelChunkSection[] sections = levelChunk.getSections();
+            this.quantumSections = new LevelChunkSection[sections.length];
+            for (int i = 0; i < sections.length; i++) this.quantumSections[i] = sections[i].copy();
+        } else {
+            extractChunkData(new FriendlyByteBuf(this.getWriteBuffer()), levelChunk, chunkPacketInfo);
+        }
         this.blockEntitiesData = Lists.newArrayList();
         int totalTileEntities = 0; // Paper - Handle oversized block entities in chunks
 
@@ -75,6 +88,23 @@ public class ClientboundLevelChunkPacketData {
         }
     }
 
+    /** Worker owns only copies; ready publication belongs to the enclosing packet. */
+    void quantumSerializeSnapshot() {
+        LevelChunkSection[] sections = java.util.Objects.requireNonNull(this.quantumSections, "Snapshot already consumed");
+        FriendlyByteBuf output = new FriendlyByteBuf(this.getWriteBuffer());
+        try {
+            for (int i = 0; i < sections.length; i++) sections[i].write(output, null, i);
+            if (output.writerIndex() != this.buffer.length) throw new IllegalStateException("Chunk snapshot size changed");
+        } finally {
+            output.release();
+            this.quantumSections = null;
+        }
+    }
+
+    void quantumDiscardSnapshot() {
+        this.quantumSections = null;
+    }
+
     public ClientboundLevelChunkPacketData(final RegistryFriendlyByteBuf input, final int x, final int z) {
